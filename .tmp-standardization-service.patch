@@ -227,6 +227,32 @@ def _quote_ident(identifier: str) -> str:
     return '"' + str(identifier).replace('"', '""') + '"'
 
 
+def _reference_dataset_ids(rules: list) -> list[str]:
+    dataset_ids: list[str] = []
+    for rule in rules:
+        if getattr(rule, "rule_type", None) != "reference_lookup" or not getattr(rule, "enabled", True):
+            continue
+        config = getattr(rule, "rule_config", None) or {}
+        configured = [
+            item.get("reference_dataset_id", item.get("referenceDatasetId"))
+            for item in config.get("lookup_configs") or []
+        ] or [config.get("lookup_table")]
+        for dataset_id in configured:
+            if dataset_id and dataset_id not in dataset_ids:
+                dataset_ids.append(dataset_id)
+    return dataset_ids
+
+
+async def _load_reference_snapshot(session: AsyncSession, rules: list) -> dict[str, list[dict[str, Any]]]:
+    snapshot: dict[str, list[dict[str, Any]]] = {}
+    from sqlalchemy import text as sa_text
+    for dataset_id in _reference_dataset_ids(rules):
+        result = await session.execute(sa_text(f"SELECT * FROM {_quote_ident(dataset_id)}"))
+        columns = list(result.keys())
+        snapshot[dataset_id] = [dict(zip(columns, row)) for row in result.fetchall()]
+    return snapshot
+
